// Prueba acordada: cristal discreto, espacio equilibrado y movimiento controlado.
// Sin borde; la sombra sigue la paleta mediante ricing-shadow.kdl.
layout {
    gaps 12

    focus-ring {
        off
    }

    border { off; }

}

window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
    draw-border-with-background false
}

animations {
    window-open {
        duration-ms 240
        curve "ease-out-cubic"
    }
    window-close {
        duration-ms 180
        curve "ease-out-cubic"
    }
    workspace-switch {
        spring stiffness=1000 damping-ratio=0.85 epsilon=0.0001
    }
    horizontal-view-movement {
        spring stiffness=800 damping-ratio=0.85 epsilon=0.0001
    }
    window-movement {
        spring stiffness=800 damping-ratio=1.0 epsilon=0.0001
    }
    window-resize {
        spring stiffness=800 damping-ratio=1.0 epsilon=0.0001
    }
    overview-open-close {
        spring stiffness=500 damping-ratio=0.80 epsilon=0.0001
    }
}
