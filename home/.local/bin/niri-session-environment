#!/bin/sh
set -eu
case "${1:-start}" in
start)
    export XCURSOR_THEME=Yaru XCURSOR_SIZE=24
    export QT_QPA_PLATFORMTHEME=gtk3
    export TERMINAL=__HOME__/.local/bin/alacritty
    export XDG_CONFIG_HOME=__HOME__/.config/niri-session
    export DCONF_PROFILE=__HOME__/.config/niri/dconf-profile
    export XDG_CURRENT_DESKTOP=niri XDG_SESSION_DESKTOP=niri
    # Este perfil dconf es exclusivo de Niri.
    gsettings set org.gnome.desktop.interface font-name "Ubuntu Sans 11"
    gsettings set org.gnome.desktop.interface monospace-font-name "Ubuntu Sans Mono 11"
    gsettings set org.gnome.desktop.interface icon-theme Mint-Y-Liquid-Clear-v1
    gsettings set org.gnome.desktop.interface cursor-theme Yaru
    gsettings set org.gnome.desktop.interface cursor-size 24
    ;;
stop)
    unset QT_QPA_PLATFORMTHEME
    export TERMINAL=x-terminal-emulator
    export XDG_CONFIG_HOME=__HOME__/.config DCONF_PROFILE=user
    export XDG_CURRENT_DESKTOP=X-Cinnamon XDG_SESSION_DESKTOP=cinnamon
    ;;
*) exit 2 ;;
esac
dbus-update-activation-environment --systemd XDG_CONFIG_HOME DCONF_PROFILE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP TERMINAL
if [ "${1:-start}" = start ]; then
    dbus-update-activation-environment --systemd XCURSOR_THEME XCURSOR_SIZE
fi
